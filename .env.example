# Public Supabase project settings.
# These are safe to ship to the browser; RLS controls access.
# Copy this file to .env.local and fill in the values for your project.
NEXT_PUBLIC_SUPABASE_URL= https://cpirkzcffqkzktdlboip.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= sb_publishable_7WOANIHqxFdflaiT2SRtdw_ek0F0xmb

# Canonical public URL used in invite and password-recovery emails. Set this to
# the live site so links never point at localhost when tested locally.
NEXT_PUBLIC_SITE_URL=https://drawtiq.netlify.app

# Do not add a service_role key to this app. It bypasses RLS. Use the Supabase
# dashboard or CLI for one-off admin setup instead.

# Optional. auto (default) uses published database content when available and
# the original hardcoded content otherwise. Set to fallback while reviewing
# content, or database to force database-only public rendering.
PUBLIC_CONTENT_SOURCE=

# Optional inquiry email notifications. Leave blank to store inquiries in
# Supabase without sending email. Supported provider: resend. Set to none to
# disable explicitly. Create the API key in your Resend account; never commit a
# real key. The sender address must be verified with the provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
INQUIRY_NOTIFICATION_TO=
INQUIRY_NOTIFICATION_FROM=

# Optional server-side salt for hashing IP addresses used by the database-backed
# inquiry rate limiter. Use a long random value in production.
INQUIRY_HASH_SALT=
